<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>navibar</title>
<style>
body {
	margin: 0;
	font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
	background-color: #f7f7f7;
}

header {
	display: flex;
	align-items: center;
	padding: 10px 20px;
	background-color: #ffffff;
	border-bottom: 1px solid #ccc;
	position: relative; /* 메뉴를 중앙에 절대 위치로 배치 */
}

.logo-img {
	height: 80px;
	object-fit: contain;
}

/* 메뉴 중앙 배치 */
.menu-container {
	position: absolute;
	left: 50%;
	transform: translateX(-50%);
}

.nav-links {
	display: flex;
	gap: 50px;
}

.nav-links a {
	width: 150px;
	height: 30px;
	text-decoration: none;
	text-align: center;
	color: #333;
	padding: 8px 12px;
	border-radius: 15px;
	border: 1px solid #ccc;
	background-color: #f5f5f5;
	transition: background-color 0.2s;
	display: flex;
	align-items: center;
	justify-content: center;
}

.nav-links a:hover {
	background-color: #e0e0e0;
}


</style>
</head>
<body>
	<!-- 로고 클릭 시 메인으로 이동 -->
	<div class="logo">
		<a href="<c:url value='/main' />"> 
		<img src="<c:url value='/resources/images/logo1.png' />" alt="Logo" class="logo-img">
		</a>
	</div>

	<!-- 메뉴 링크들 -->
	<nav class="nav-links">
		<a href="<c:url value='/profile' />">Profile</a> 
		<a href="<c:url value='/blog/list' />">Blog</a>
		<a href="<c:url value='/book/list' />">Book</a> 
		<a href="<c:url value='/movie/list' />">Movie</a>
	</nav>


</body>
</html>